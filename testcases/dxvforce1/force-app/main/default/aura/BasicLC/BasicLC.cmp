<aura:component controller="LCInfoBean" implements="force:appHostable,flexipage:availableForAllPageTypes">
    <aura:attribute name="goodval" type="String"/>
    <aura:attribute name="badval1" type="String"/>
    <aura:attribute name="badval2" type="String"/>



    <aura:handler name="init" value="{!this}" action="{!c.myAction}" />

    <lightning:layout horizontalAlign="space" multipleRows="true">
        <lightning:layoutItem size="12"
                              mediumDeviceSize="12"
                              padding="around-small">
            <div class="slds-box slds-theme_default">
                Account Search component goes here
            </div>
        </lightning:layoutItem>
        <lightning:layoutItem size="12"
                              mediumDeviceSize="6"
                              padding="around-small">
            <div class="slds-box slds-theme_default">
                Account List component goes here
            </div>
        </lightning:layoutItem>
        <lightning:layoutItem size="12"
                              mediumDeviceSize="6"
                              padding="around-small">
            <div class="slds-box slds-theme_default">
                Account Map goes here
            </div>
        </lightning:layoutItem>
    </lightning:layout>
    goodval:
    <aura:unescapedHtml value="{!v.goodval}"></aura:unescapedHtml>
    badval1:
    <aura:unescapedHtml value="{!v.badval1}"></aura:unescapedHtml>      <!-- CWEID 80 -->
    badval2:
    <aura:unescapedHtml value="{!v.badval2}"></aura:unescapedHtml>      <!-- CWEID 80 -->

    goodval:
    <aura:unescapedHtml value="{#v.goodval}"></aura:unescapedHtml>
    badval1:
    <aura:unescapedHtml value="{#v.badval1}"></aura:unescapedHtml>      <!-- CWEID 80 -->
    badval2:
    <aura:unescapedHtml value="{#v.badval2}"></aura:unescapedHtml>      <!-- CWEID 80 -->


    <div>
        <div id="output1">output1</div>
        <div id="output2">output2</div>
        <div id="output3">output3</div>
        <div id="output4">output4</div>
        <div id="output5">output5</div>
        <div id="output6">output6</div>
        <div id="output7">output7</div>
        <div id="output8">output8</div>
        <div id="output9">output9</div>
        <div id="output10">output10</div>
    </div>
</aura:component>
